# Keep UIKit's bundle declaration and SDL's view-controller mask on the same explicit selection.
set(HELENGINE_IOS_SCREEN_ORIENTATION "unspecified" CACHE STRING "Authored iOS orientation: unspecified, portrait or landscape")
set_property(CACHE HELENGINE_IOS_SCREEN_ORIENTATION PROPERTY STRINGS unspecified portrait landscape)
if(HELENGINE_IOS_SCREEN_ORIENTATION STREQUAL "portrait")
    set(HELENGINE_IOS_SUPPORTED_ORIENTATIONS "<string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string>")
    set(HELENGINE_IOS_SDL_ORIENTATIONS "Portrait PortraitUpsideDown")
elseif(HELENGINE_IOS_SCREEN_ORIENTATION STREQUAL "landscape")
    set(HELENGINE_IOS_SUPPORTED_ORIENTATIONS "<string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string>")
    set(HELENGINE_IOS_SDL_ORIENTATIONS "LandscapeLeft LandscapeRight")
elseif(HELENGINE_IOS_SCREEN_ORIENTATION STREQUAL "unspecified")
    set(HELENGINE_IOS_SUPPORTED_ORIENTATIONS "<string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string>")
    set(HELENGINE_IOS_SDL_ORIENTATIONS "")
else()
    message(FATAL_ERROR "HELENGINE_IOS_SCREEN_ORIENTATION must be unspecified, portrait or landscape")
endif()
