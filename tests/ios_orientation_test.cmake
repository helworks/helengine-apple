cmake_minimum_required(VERSION 3.31)
get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(selection unspecified portrait landscape)
    set(HELENGINE_IOS_SCREEN_ORIENTATION "${selection}")
    include("${repository}/cmake/IosScreenOrientation.cmake")
    if(selection STREQUAL "unspecified")
        if(NOT HELENGINE_IOS_SDL_ORIENTATIONS STREQUAL "" OR NOT HELENGINE_IOS_SUPPORTED_ORIENTATIONS MATCHES "Portrait" OR NOT HELENGINE_IOS_SUPPORTED_ORIENTATIONS MATCHES "LandscapeLeft")
            message(FATAL_ERROR "Unspecified orientation must preserve all rotations")
        endif()
    elseif(selection STREQUAL "portrait")
        if(NOT HELENGINE_IOS_SDL_ORIENTATIONS STREQUAL "Portrait PortraitUpsideDown" OR HELENGINE_IOS_SUPPORTED_ORIENTATIONS MATCHES "Landscape")
            message(FATAL_ERROR "Portrait SDL and plist selections differ")
        endif()
    elseif(selection STREQUAL "landscape")
        if(NOT HELENGINE_IOS_SDL_ORIENTATIONS STREQUAL "LandscapeLeft LandscapeRight" OR HELENGINE_IOS_SUPPORTED_ORIENTATIONS MATCHES "Portrait")
            message(FATAL_ERROR "Landscape SDL and plist selections differ")
        endif()
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -DHELENGINE_IOS_SCREEN_ORIENTATION=sideways -P "${repository}/cmake/IosScreenOrientation.cmake" RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET)
if(rejected EQUAL 0)
    message(FATAL_ERROR "Unknown orientation must fail native configuration")
endif()
message(STATUS "iOS orientation: all three plist/SDL selections and invalid selection passed")
